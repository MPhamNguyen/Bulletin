# Set these in the Vercel project's environment settings. Root Directory: admin.
# SUPABASE_SERVICE_ROLE_KEY is server-only; never place it in HTML or browser code.
# Existing profiles.is_admin must be protected from ordinary client updates.
# The portal uses the existing reports status constraint:
# open, in_review, resolved, dismissed.
# reports.modified_at must accept a timestamp with time zone.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=replace-with-at-least-32-random-characters
# Only for local HTTP development; Vercel always uses secure cookies.
ADMIN_LOCAL_HTTP=false
